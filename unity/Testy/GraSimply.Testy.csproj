<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Projekt testowy warstw Logika i Grafika. Obie są czystym C# bez UnityEngine,
    więc dają się skompilować i uruchomić zwykłym dotnetem — bez edytora Unity.
    Dzięki temu port da się sprawdzać w CI i porównywać z wersją pythonową.

    Uruchomienie z katalogu unity/Testy:
      dotnet run
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>GraSimply.Testy</AssemblyName>
    <RootNamespace>GraSimply.Testy</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../GraSimply/Assets/Scripts/Logika/**/*.cs" />
    <Compile Include="../GraSimply/Assets/Scripts/Grafika/**/*.cs" />
  </ItemGroup>

</Project>
